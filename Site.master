<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>
<!doctype html>
<html lang="en">
<head runat="server">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">KUET Career Club</asp:ContentPlaceHolder></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="style.css" />
  <style>
    :root {
      /* primary color unified with style.css --brand */
      --bcc-primary: var(--brand);
      --bcc-dark: #1A202C;
      --bcc-muted: #4A5568;
    }
    .notice-marquee-container { background: #f0f7ff; border-bottom: 1.5px solid rgba(0,86,162,0.08); overflow: hidden; }
    .notice-badge { background: var(--bcc-primary); color: white; font-weight: 700; padding: 6px 16px; z-index: 10; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .marquee-text a { color: var(--bcc-dark); font-weight: 500; text-decoration: none; transition: color 0.2s; }
    .marquee-text a:hover { color: var(--bcc-primary); }
    .job-card { background: #ffffff; border: 1px solid #E2E8F0; border-radius: 12px; border-top: 4px solid var(--bcc-primary); transition: all 0.25s ease; }
    .job-card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
    .card-feature, .collab-card { background: #ffffff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px; transition: all 0.25s ease; }
    .card-feature:hover, .collab-card:hover { border-color: #cbd5e1; box-shadow: 0 8px 16px rgba(0,0,0,0.04); }
    .collab-card.active-card { border: 1.5px solid var(--bcc-primary); background: #fffafb; }
    .bg-info-soft { background-color: #ebf8ff; color: #2b6cb0; }
    .bg-success-soft { background-color: #f0fff4; color: #2f855a; }
    .bg-orange-soft { background-color: #fff7ed; color: #c2410c; }
    h1,h2,h3,h5 { color: var(--bcc-dark); font-weight:700 !important; }
    .eyebrow { color: var(--bcc-primary); font-weight:700; text-transform:uppercase; letter-spacing:1px; font-size:0.85rem; }
  </style>
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
  <meta property="og:site_name" content="KUET Career Club" />
  <meta property="og:type" content="website" />
  <link rel="canonical" href="<%= Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath.TrimEnd('/') + '/' %>" />
</head>
<body class="bg-light">
  <form id="form1" runat="server">
    
    <header class="site-header shadow-sm bg-white">
      <div class="container py-2 d-flex align-items-center justify-content-between">
        <a class="brand" href="home.aspx">
          <img src="images/logo.jpg" alt="KUET Career Club logo" class="log" />
          <div class="logo-text ms-2">
            <div class="site-title">KUET CAREER Club</div>
            <small class="site-sub">Prepare • Connect • Succeed</small>
          </div>
        </a>

        <nav class="d-none d-md-block">
          <ul class="nav align-items-center mb-0">
            <li class="nav-item"><a id="navHome" runat="server" class="nav-link fw-semibold" href="home.aspx">Home</a></li>
            <li class="nav-item"><a id="navJobs" runat="server" class="nav-link fw-semibold" href="jobs.aspx">Jobs</a></li>
            <li class="nav-item"><a id="navBlogs" runat="server" class="nav-link fw-semibold" href="blogs.aspx">Blogs</a></li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle fw-semibold" href="#" id="portalsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-grid-fill me-1"></i>Portals</a>
              <ul class="dropdown-menu border-0 shadow" aria-labelledby="portalsDropdown">
                <li><a class="dropdown-item" href="students.aspx">Student Portal</a></li>
                <li><a class="dropdown-item" href="alumni.aspx">Graduate Portal</a></li>
                <li><a class="dropdown-item" href="companies.aspx">Industry Partner</a></li>
              </ul>
            </li>
            <li class="nav-item"><a class="nav-link fw-semibold" href="home.aspx#events">Events</a></li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle fw-semibold" href="#" id="moreDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">More</a>
              <ul class="dropdown-menu border-0 shadow" aria-labelledby="moreDropdown">
                <li><a class="dropdown-item" href="students.aspx">Student Portal</a></li>
                <li><a class="dropdown-item" href="alumni.aspx">Graduate Corner</a></li>
                <li><a class="dropdown-item" href="companies.aspx">Companies</a></li>
                <li><a class="dropdown-item" href="jobs.aspx">Jobs &amp; Internships</a></li>
                <li><a class="dropdown-item" href="collaborate.aspx">Collaborate</a></li>
                <li><a class="dropdown-item" href="support.aspx">Support / Donate</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="help.aspx">Help Center</a></li>
                <li><a class="dropdown-item" href="faq.aspx">FAQs</a></li>
                <li><a class="dropdown-item" href="contact.aspx">Contact Us</a></li>
                <li><a class="dropdown-item" href="feedback.aspx">Feedback</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="privacy.aspx">Privacy Policy</a></li>
                <li><a class="dropdown-item" href="terms.aspx">Terms of Service</a></li>
                <li><a class="dropdown-item" href="refund.aspx">Return &amp; Refund Policy</a></li>
              </ul>
            </li>
          </ul>
        </nav>

        <div class="d-none d-md-flex gap-2 header-actions align-items-center">
          <asp:PlaceHolder ID="phAnonymous" runat="server">
             <a href="login.aspx" class="btn btn-outline-custom fw-semibold">Sign In</a>
             <a href="register.aspx" class="btn btn-primary-custom text-white fw-semibold">Register</a>
          </asp:PlaceHolder>
          <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
             <span class="text-dark fw-semibold me-2 small">
                 <i class="bi bi-person-circle text-primary me-1"></i>Welcome, 
                 <asp:Label ID="lblUserName" runat="server" CssClass="text-primary"></asp:Label>
             </span>
             <asp:Button ID="btnLogout" runat="server" Text="Logout" CssClass="btn btn-sm btn-outline-danger px-3 fw-semibold" OnClick="BtnLogout_Click" OnClientClick="window.location='logout.aspx'; return false;" />
          </asp:PlaceHolder>
        </div>

        <div class="d-md-none">
          <button class="btn btn-outline-secondary mobile-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-label="Open menu"><i class="bi bi-list"></i></button>
        </div>
      </div>
    </header>

    <div class="offcanvas offcanvas-end text-bg-white" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
      <div class="offcanvas-header border-bottom">
        <h5 id="mobileMenuLabel" class="offcanvas-title fw-bold">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="nav flex-column gap-2">
          <li class="nav-item"><a id="navHomeMobile" runat="server" class="nav-link fw-semibold" href="home.aspx">Home</a></li>
          <li class="nav-item"><a id="navJobsMobile" runat="server" class="nav-link fw-semibold" href="jobs.aspx">Jobs</a></li>
          <li class="nav-item"><a id="navBlogsMobile" runat="server" class="nav-link fw-semibold" href="blogs.aspx">Blogs</a></li>
          <li class="nav-item">
            <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#portalSubmenu" role="button" aria-expanded="false" aria-controls="portalSubmenu">Portals <i class="bi bi-caret-down-fill"></i></a>
            <div class="collapse ps-3" id="portalSubmenu">
              <ul class="nav flex-column gap-2 mt-2">
                <li class="nav-item"><a class="nav-link" href="students.aspx">Student Portal</a></li>
                <li class="nav-item"><a class="nav-link" href="alumni.aspx">Graduate Portal</a></li>
                <li class="nav-item"><a class="nav-link" href="companies.aspx">Industry Partner</a></li>
              </ul>
            </div>
          </li>
          <li class="nav-item"><a class="nav-link fw-semibold" href="home.aspx#events">Events</a></li>
          <li class="nav-item">
            <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#moreSubmenu" role="button" aria-expanded="false" aria-controls="moreSubmenu">More <i class="bi bi-caret-down-fill"></i></a>
            <div class="collapse ps-3" id="moreSubmenu">
              <ul class="nav flex-column gap-2 mt-2">
                <li class="nav-item"><a class="nav-link" href="students.aspx">Student Portal</a></li>
                <li class="nav-item"><a class="nav-link" href="alumni.aspx">Graduate Corner</a></li>
                <li class="nav-item"><a class="nav-link" href="companies.aspx">Companies</a></li>
                <li class="nav-item"><a class="nav-link" href="jobs.aspx">Jobs &amp; Internships</a></li>
                <li class="nav-item"><a class="nav-link" href="collaborate.aspx">Collaborate</a></li>
                <li class="nav-item"><a class="nav-link" href="support.aspx">Support / Donate</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li class="nav-item"><a class="nav-link" href="help.aspx">Help Center</a></li>
                <li class="nav-item"><a class="nav-link" href="faq.aspx">FAQs</a></li>
                <li class="nav-item"><a class="nav-link" href="contact.aspx">Contact Us</a></li>
                <li class="nav-item"><a class="nav-link" href="feedback.aspx">Feedback</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li class="nav-item"><a class="nav-link" href="privacy.aspx">Privacy Policy</a></li>
                <li class="nav-item"><a class="nav-link" href="terms.aspx">Terms of Service</a></li>
                <li class="nav-item"><a class="nav-link" href="refund.aspx">Return &amp; Refund Policy</a></li>
              </ul>
            </div>
          </li>
        </ul>

        <div class="mt-4">
                 <asp:PlaceHolder ID="phAnonymousMobile" runat="server">
             <div class="d-flex gap-2">
                 <a href="login.aspx" class="btn btn-outline-secondary w-100 btn-sm fw-semibold">Sign In</a>
                 <a href="register.aspx" class="btn btn-primary-custom text-white w-100 btn-sm fw-semibold">Register</a>
             </div>
          </asp:PlaceHolder>
          <asp:PlaceHolder ID="phLoggedInMobile" runat="server" Visible="false">
             <div class="text-center p-2 border rounded bg-light mb-2">
                 <span class="text-dark fw-semibold small d-block">
                     <i class="bi bi-person-circle text-primary me-1"></i>Welcome, 
                     <asp:Label ID="lblUserNameMobile" runat="server" CssClass="text-primary"></asp:Label>
                 </span>
             </div>
             <asp:Button ID="btnLogoutMobile" runat="server" Text="Logout" CssClass="btn btn-sm btn-danger w-100 fw-semibold" OnClick="BtnLogout_Click" OnClientClick="window.location='logout.aspx'; return false;" />
          </asp:PlaceHolder>
        </div>
      </div>
    </div>

    <main>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="site-footer pt-5 pb-3 border-top bg-white mt-5">
      <div class="container">
        <div class="row gy-4">
          <div class="col-lg-4 col-md-6">
            <div class="footer-brand d-flex align-items-center mb-3">
              <img src="images/logo.jpg" alt="KUET Career Center Logo" class="footer-logo" style="height: 45px;" />
              <div class="logo-text ms-2">
                <div class="footer-site-title fw-bold text-dark" style="font-size: 1.15rem; font-weight: 800;">KUET Career Club</div>
                <small class="text-muted d-block" style="font-size: 0.75rem;">Prepare • Connect • Succeed</small>
              </div>
            </div>
            <p class="text-muted small pe-lg-4">
              Join thousands of KUET students, alumni, and industry partners building the future of engineering excellence.
            </p>
          </div>

          <div class="col-lg-2 col-md-6">
            <h6 class="footer-heading text-uppercase fw-bold text-dark small mb-3" style="letter-spacing: 0.5px;">Quick Links</h6>
            <ul class="list-unstyled footer-links small d-flex flex-column gap-2">
              <li><a href="students.aspx" class="text-muted text-decoration-none">Student Portal</a></li>
              <li><a href="alumni.aspx" class="text-muted text-decoration-none">Alumni Corner</a></li>
              <li><a href="companies.aspx" class="text-muted text-decoration-none">Industry Partners</a></li>
              <li><a href="jobs.aspx" class="text-muted text-decoration-none">Job Board</a></li>
            </ul>
          </div>

          <div class="col-lg-2 col-md-6">
            <h6 class="footer-heading text-uppercase fw-bold text-dark small mb-3" style="letter-spacing: 0.5px;">Support</h6>
            <ul class="list-unstyled footer-links small d-flex flex-column gap-2">
              <li><a href="help.aspx" class="text-muted text-decoration-none">Help Center</a></li>
              <li><a href="faq.aspx" class="text-muted text-decoration-none">FAQs</a></li>
              <li><a href="privacy.aspx" class="text-muted text-decoration-none">Privacy Policy</a></li>
              <li><a href="terms.aspx" class="text-muted text-decoration-none">Terms of Service</a></li>
            </ul>
          </div>

          <div class="col-lg-4 col-md-6">
            <h6 class="footer-heading text-uppercase fw-bold text-dark small mb-3" style="letter-spacing: 0.5px;">Contact Info</h6>
            <ul class="list-unstyled footer-contact-list small d-flex flex-column gap-2 text-muted">
              <li class="d-flex align-items-start gap-2">
                <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                <span>KUET Career Club, KUET Campus,<br />Khulna, Bangladesh.</span>
              </li>
              <li class="d-flex align-items-center gap-2">
                <i class="bi bi-envelope-fill text-secondary"></i>
                <a href="mailto:info@kuetcareerclub.edu" class="text-muted text-decoration-none">info@kuetcareerclub.edu</a>
              </li>
              <li class="d-flex align-items-center gap-2">
                <i class="bi bi-telephone-fill text-success"></i>
                <span>+880-XXX-XXXXXX</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom border-top mt-4 pt-3 text-center">
          <p class="mb-0 text-muted small">&copy; 2026 KUET Career Club | All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="script.js"></script>
  </form>
</body>
</html>